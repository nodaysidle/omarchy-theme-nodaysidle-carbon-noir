#!/bin/bash
# Omarchy Theme Hook for Nodaysidle Carbon Noir
set -euo pipefail

THEME="${1:-}"

if [[ "$THEME" == "nodaysidle-carbon-noir" || "$THEME" == "Nodaysidle Carbon Noir" ]]; then
  CURSOR_BIN="$HOME/.config/omarchy/plugins/taxin.cursor-style/bin/omarchy-cursor-set"
  if [[ -x "$CURSOR_BIN" ]]; then
    "$CURSOR_BIN" "Omarchy-Carbon-Noir" >/dev/null 2>&1 || true
  else
    hyprctl setcursor "Omarchy-Carbon-Noir" 24 >/dev/null 2>&1 || true
    gsettings set org.gnome.desktop.interface cursor-theme "Omarchy-Carbon-Noir" >/dev/null 2>&1 || true
  fi
fi
